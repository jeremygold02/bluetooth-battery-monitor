<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>BluetoothBatteryMonitor</AssemblyName>
    <RootNamespace>CodexUsageTray</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <StartupObject>CodexUsageTray.LegacyHost</StartupObject>
    <LegacyVersion Condition="'$(LegacyVersion)' == ''">0.1.7</LegacyVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="LegacyHost.cs" />
    <Compile Include="..\legacy\$(LegacyVersion)\UpdateService.cs" />
    <Compile Include="..\legacy\AppVersion.cs" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <Target Name="GenerateBuildVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <BuildVersionFile>$(IntermediateOutputPath)BuildVersion.g.cs</BuildVersionFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(BuildVersionFile)" Overwrite="true" Lines="namespace CodexUsageTray { internal static class BuildVersion { public const string Version = &quot;$(LegacyVersion)&quot;%3B public const string GitHubOwner = &quot;jeremygold02&quot;%3B public const string GitHubRepo = &quot;bluetooth-battery-monitor&quot;%3B } }" />
    <ItemGroup>
      <Compile Include="$(BuildVersionFile)" />
    </ItemGroup>
  </Target>
</Project>

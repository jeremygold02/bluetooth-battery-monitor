<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>BluetoothBatteryMonitor</AssemblyName>
    <RootNamespace>CodexUsageTray</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>..\icon.ico</ApplicationIcon>
    <BridgeVersion Condition="'$(BridgeVersion)' == ''">0.0.0</BridgeVersion>
    <GitHubOwner Condition="'$(GitHubOwner)' == ''">jeremygold02</GitHubOwner>
    <GitHubRepo Condition="'$(GitHubRepo)' == ''">bluetooth-battery-monitor</GitHubRepo>
    <NativeExecutable Condition="'$(NativeExecutable)' == ''">..\target\release\BluetoothBatteryMonitor.exe</NativeExecutable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Bridge.cs" />
    <Reference Include="System.Windows.Forms" />
    <EmbeddedResource Include="$(NativeExecutable)">
      <LogicalName>BluetoothBatteryMonitor.Native.exe</LogicalName>
      <Link>BluetoothBatteryMonitor.Native.exe</Link>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="GenerateBuildVersion" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(NativeExecutable)')" Text="The native app was not found: $(NativeExecutable)" />
    <PropertyGroup>
      <BuildVersionFile>$(IntermediateOutputPath)BuildVersion.g.cs</BuildVersionFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(BuildVersionFile)" Overwrite="true" Lines="namespace CodexUsageTray { internal static class BuildVersion { public const string Version = &quot;$(BridgeVersion)&quot;%3B public const string GitHubOwner = &quot;$(GitHubOwner)&quot;%3B public const string GitHubRepo = &quot;$(GitHubRepo)&quot;%3B } }" />
    <ItemGroup>
      <Compile Include="$(BuildVersionFile)" />
    </ItemGroup>
  </Target>
</Project>

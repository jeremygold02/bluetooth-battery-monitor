<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType Condition="'$(TestSource)' == ''">WinExe</OutputType>
    <OutputType Condition="'$(TestSource)' != ''">Exe</OutputType>
    <AssemblyName Condition="'$(TestSource)' == ''">BluetoothBatteryMonitor</AssemblyName>
    <AssemblyName Condition="'$(TestSource)' != ''">BluetoothBatteryTests</AssemblyName>
    <StartupObject Condition="'$(TestSource)' != ''">$(TestMain)</StartupObject>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <FrameworkRuntimeDir Condition="Exists('$(WinDir)\Microsoft.NET\Framework64\v4.0.30319\System.Runtime.WindowsRuntime.dll')">$(WinDir)\Microsoft.NET\Framework64\v4.0.30319</FrameworkRuntimeDir>
    <FrameworkRuntimeDir Condition="'$(FrameworkRuntimeDir)' == ''">$(WinDir)\Microsoft.NET\Framework\v4.0.30319</FrameworkRuntimeDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="CodexUsageTray.cs" />
    <Compile Include="src\*.cs" />
    <Compile Include="$(TestSource)" Condition="'$(TestSource)' != ''" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Runtime.WindowsRuntime">
      <HintPath>$(FrameworkRuntimeDir)\System.Runtime.WindowsRuntime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Runtime.InteropServices.WindowsRuntime">
      <HintPath>$(FrameworkRuntimeDir)\System.Runtime.InteropServices.WindowsRuntime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="WindowsFormsIntegration" />
    <Reference Include="Windows">
      <HintPath>$(WindowsMetadataPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Windows.Foundation.UniversalApiContract">
      <HintPath>$(UniversalContractPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Windows.Foundation.FoundationContract">
      <HintPath>$(FoundationContractPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
  <!-- Bundle managed dependencies without relying on machine-specific package paths. -->
  <Target Name="EmbedRuntimeDependencies" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveReferences" Condition="'$(TestSource)' == ''">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'">
        <LogicalName>BluetoothBatteryMonitor.Embedded.%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>
